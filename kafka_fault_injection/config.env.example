# Copy to config.env and fill in. config.env is gitignored.
#
# Lab model: 3 Kafka KRaft nodes + injector (docker-node)
#   kafka-n1/n2/n3  @ 10.10.26.144/145/146 :9092 / :9093
#   docker-node     @ 10.10.26.10

export INJECT_BACKEND="docker"

export KAFKA_NODES="10.10.26.144:9092 10.10.26.145:9092 10.10.26.146:9092"
export KAFKA_CONTAINER_MAP="10.10.26.144:kafka-n1 10.10.26.145:kafka-n2 10.10.26.146:kafka-n3"
export BOOTSTRAP="10.10.26.144:9092,10.10.26.145:9092,10.10.26.146:9092"

export KAFKA_HOME="/opt/kafka/3.8.1"
export KAFKA_PORT=9092
export CONTROLLER_PORT=9093
export KAFKA_DATA_DIR="/var/lib/kafka/data"
export KAFKA_LOG_DIR="/var/log/kafka"
export KAFKA_CONF="/etc/kafka/server.properties"
export FAULT_TOPIC="fault-inject"
export FAULT_DURATION_SEC=600

export SSH_USER="root"
export TARGET_HOST=""
export NET_DEV="eth0"
