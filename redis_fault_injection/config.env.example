# Copy to config.env and adjust for your lab.
# Default matches V1.2 document environment.

export REDIS_NODES="10.10.26.144:6381 10.10.26.145:6381 10.10.26.146:6381"
export REDIS_PASSWORD=""
export REDIS_CLI="redis-cli"

# Cluster bus port (default 16379 = client_port + 10000)
export CLUSTER_BUS_PORT=16379

# Host-side injection target. Leave empty to apply on local host only.
export TARGET_HOST=""

# Typical sustained fault duration for diagnosis pipeline (seconds)
export FAULT_DURATION_SEC=240

# SSH user when TARGET_HOST points to a remote VM
export SSH_USER="root"

# Paths used by persistence fault injection
export REDIS_DATA_DIR="/var/lib/redis"
export REDIS_RDB_NAME="dump.rdb"
