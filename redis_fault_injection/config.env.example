# Copy to config.env and adjust for your lab.

# Primary injection/diagnosis host (single-machine mode: leave TARGET_HOST empty)
export TARGET_HOST=""

# Redis cluster endpoints visible from the injection host
export REDIS_NODES="10.10.26.144:6381 10.10.26.145:6381 10.10.26.146:6381"
export REDIS_PASSWORD=""
export REDIS_CLI="redis-cli"

export CLUSTER_BUS_PORT=16379

# Sustained fault default: 10 minutes (override with --duration)
export FAULT_DURATION_SEC=600

# Only needed when TARGET_HOST is set
export SSH_USER="root"

export REDIS_DATA_DIR="/var/lib/redis"
export REDIS_CONF="/etc/redis/redis.conf"
export REDIS_SERVICE="redis"

# For WRONGPASS pulse (optional)
export REDIS_ACL_USER="default"
