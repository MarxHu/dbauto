# Copy to config.env and fill in secrets. config.env is gitignored.
#
# Lab model (default):
#   Injection bot runs on docker-node.
#   Redis is binary-deployed inside Docker containers that simulate VMs.
#   Host/network/disk faults use: docker exec <container> ...
#   Redis-level faults use: redis-cli from the bot to REDIS_NODES.

export INJECT_BACKEND="docker"   # docker | ssh | local

# Redis endpoints as seen from the bot (container IP:client port)
export REDIS_NODES="10.10.26.144:6379 10.10.26.145:6379 10.10.26.146:6379"

# Map container IP -> docker container name (recommended; required if IP auto-detect fails)
# Example: export REDIS_CONTAINER_MAP="10.10.26.144:redis-144 10.10.26.145:redis-145 10.10.26.146:redis-146"
export REDIS_CONTAINER_MAP=""

# Or list containers in the same order as REDIS_NODES:
# export REDIS_CONTAINERS="redis-144 redis-145 redis-146"

# Redis auth (required when cluster uses requirepass)
export REDIS_PASSWORD=""

export REDIS_CLI="redis-cli"
# Cluster bus = client_port + 10000 unless overridden
export CLUSTER_BUS_PORT=16379

export FAULT_DURATION_SEC=600

# "auto" = use CONFIG GET dir (e.g. /var/lib/redis/6379)
export REDIS_DATA_DIR="auto"
export REDIS_CONF="/etc/redis/redis.conf"
export REDIS_SERVICE="redis"

export REDIS_ACL_USER="default"
export MISCONF_CLEANUP_RESTART="YES"

# Only used when INJECT_BACKEND=ssh
export SSH_USER="root"
export TARGET_HOST=""
