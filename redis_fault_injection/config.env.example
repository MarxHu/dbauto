# Copy to config.env and fill in secrets. config.env is gitignored.
#
# Deployment: injection bot runs OUTSIDE Docker/VM nodes.
# Host/network/disk faults SSH into VMs; Redis faults use redis-cli from bot.

export TARGET_HOST=""

export REDIS_NODES="10.10.26.144:6381 10.10.26.145:6381 10.10.26.146:6381"

# Redis auth (required when cluster uses requirepass)
export REDIS_PASSWORD=""

export REDIS_CLI="redis-cli"
export CLUSTER_BUS_PORT=16379

export FAULT_DURATION_SEC=600

export SSH_USER="root"

# Linux package default; preflight also reads `CONFIG GET dir` to verify
export REDIS_DATA_DIR="/var/lib/redis"
export REDIS_CONF="/etc/redis/redis.conf"
export REDIS_SERVICE="redis"

export REDIS_ACL_USER="default"

# Set YES to allow historical-misconf-cleanup to restart redis (clears ERRORSTATS)
export MISCONF_CLEANUP_RESTART="YES"
