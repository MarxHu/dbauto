# Copy to config.env (gitignored) and fill secrets.
# Docker lab defaults match redis/kafka 10.10.26.0/24.
# SOPS delivery: set MYSQL_NODES to 172.30.0.11:3306 172.30.0.12:3306 172.30.0.13:3306
# and INJECT_BACKEND=ssh.

export INJECT_BACKEND="docker"

export MYSQL_PRIMARY="10.10.26.144:3306"
export MYSQL_REPLICAS="10.10.26.145:3306 10.10.26.146:3306"
export MYSQL_NODES="${MYSQL_PRIMARY} ${MYSQL_REPLICAS}"

export MYSQL_CONTAINER_MAP="10.10.26.144:mysql-n1 10.10.26.145:mysql-n2 10.10.26.146:mysql-n3"

export MYSQL_USER="root"
export MYSQL_PASSWORD="change-me"
export MYSQL_PORT="3306"

export MYSQL_DATADIR="auto"
export FAULT_DURATION_SEC=600

# CI / no-lab: INJECT_DRY_RUN=1 skips docker/iptables/mysql side effects
# export INJECT_DRY_RUN=1

# Semi-sync (must match deployed topology)
export SEMI_SYNC_WAIT_REPLICA_COUNT=1
export SEMI_SYNC_TIMEOUT_MS=10000

# SSH backend
# export SSH_USER="root"
